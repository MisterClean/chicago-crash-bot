// src/templates/email/report-template.mjml
`<mjml>
  <mj-head>
    <mj-title>{{reportType}} Traffic Safety Report</mj-title>
    <mj-font name="Roboto" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700" />
    <mj-attributes>
      <mj-all font-family="Roboto, Arial, sans-serif" />
      <mj-text font-weight="400" font-size="16px" color="#000000" line-height="24px" />
      <mj-section padding="0px" />
    </mj-attributes>
    <mj-style>
      .link-nostyle { color: inherit; text-decoration: none }
      .footer-link { color: #2563EB; text-decoration: none }
      .metric-card {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        overflow: hidden;
      }
      .metric-up {
        color: #DC2626;
      }
      .metric-down {
        color: #059669;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f8fafc">
    <mj-section padding="20px 0">
      <mj-column>
        <mj-image src="https://via.placeholder.com/200x80.png?text=Chicago+Safety" alt="Chicago Traffic Safety" width="200px" padding="20px" />
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-size="24px" font-weight="700" padding-bottom="10px">
          {{reportType}} Traffic Safety Report
        </mj-text>
        <mj-text font-size="18px" color="#64748b" padding-bottom="20px">
          {{geoType}} | {{startDate}} - {{endDate}}
        </mj-text>

        <mj-text>
          Hello {{userName}},
        </mj-text>
        
        <mj-text>
          Here's your {{reportType}} traffic safety report for {{geoType}}. This report summarizes crash data for the period {{startDate}} to {{endDate}}.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="0 20px 20px 20px">
      <mj-column width="100%">
        <mj-text font-size="20px" font-weight="600" padding-bottom="10px">
          Key Metrics
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Metrics Row 1 -->
    <mj-section background-color="#ffffff" padding="0 20px 20px 20px">
      <mj-column width="50%" padding="0 10px 0 0">
        <mj-section css-class="metric-card" padding="15px">
          <mj-column>
            <mj-text font-size="14px" color="#64748b" padding-bottom="5px">
              Total Crashes
            </mj-text>
            <mj-text font-size="24px" font-weight="700" padding="0">
              {{totalCrashes}} <span style="font-size: 14px;">{{totalCrashesChange}}</span>
            </mj-text>
          </mj-column>
        </mj-section>
      </mj-column>
      <mj-column width="50%" padding="0 0 0 10px">
        <mj-section css-class="metric-card" padding="15px">
          <mj-column>
            <mj-text font-size="14px" color="#64748b" padding-bottom="5px">
              Total Injuries
            </mj-text>
            <mj-text font-size="24px" font-weight="700" padding="0">
              {{totalInjuries}} <span style="font-size: 14px;">{{totalInjuriesChange}}</span>
            </mj-text>
          </mj-column>
        </mj-section>
      </mj-column>
    </mj-section>

    <!-- Metrics Row 2 -->
    <mj-section background-color="#ffffff" padding="0 20px 20px 20px">
      <mj-column width="50%" padding="0 10px 0 0">
        <mj-section css-class="metric-card" padding="15px">
          <mj-column>
            <mj-text font-size="14px" color="#64748b" padding-bottom="5px">
              Serious Injuries
            </mj-text>
            <mj-text font-size="24px" font-weight="700" padding="0">
              {{seriousInjuries}} <span style="font-size: 14px;">{{seriousInjuriesChange}}</span>
            </mj-text>
          </mj-column>
        </mj-section>
      </mj-column>
      <mj-column width="50%" padding="0 0 0 10px">
        <mj-section css-class="metric-card" padding="15px">
          <mj-column>
            <mj-text font-size="14px" color="#64748b" padding-bottom="5px">
              Fatalities
            </mj-text>
            <mj-text font-size="24px" font-weight="700" padding="0">
              {{fatalities}} <span style="font-size: 14px;">{{fatalitiesChange}}</span>
            </mj-text>
          </mj-column>
        </mj-section>
      </mj-column>
    </mj-section>

    <!-- Vulnerable Users Metrics -->
    <mj-section background-color="#ffffff" padding="0 20px 20px 20px">
      <mj-column width="100%">
        <mj-text font-size="20px" font-weight="600" padding="20px 0 10px 0">
          Vulnerable Road Users
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Metrics Row 3 -->
    <mj-section background-color="#ffffff" padding="0 20px 20px 20px">
      <mj-column width="50%" padding="0 10px 0 0">
        <mj-section css-class="metric-card" padding="15px">
          <mj-column>
            <mj-text font-size="14px" color="#64748b" padding-bottom="5px">
              Pedestrian Crashes
            </mj-text>
            <mj-text font-size="24px" font-weight="700" padding="0">
              {{pedestrianCrashes}} <span style="font-size: 14px;">{{pedestrianCrashesChange}}</span>
            </mj-text>
          </mj-column>
        </mj-section>
      </mj-column>
      <mj-column width="50%" padding="0 0 0 10px">
        <mj-section css-class="metric-card" padding="15px">
          <mj-column>
            <mj-text font-size="14px" color="#64748b" padding-bottom="5px">
              Cyclist Crashes
            </mj-text>
            <mj-text font-size="24px" font-weight="700" padding="0">
              {{cyclistCrashes}} <span style="font-size: 14px;">{{cyclistCrashesChange}}</span>
            </mj-text>
          </mj-column>
        </mj-section>
      </mj-column>
    </mj-section>

    <!-- Metrics Row 4 -->
    <mj-section background-color="#ffffff" padding="0 20px 20px 20px">
      <mj-column width="50%" padding="0 10px 0 0">
        <mj-section css-class="metric-card" padding="15px">
          <mj-column>
            <mj-text font-size="14px" color="#64748b" padding-bottom="5px">
              Child VRU Injuries
            </mj-text>
            <mj-text font-size="24px" font-weight="700" padding="0">
              {{childVRUCrashes}} <span style="font-size: 14px;">{{childVRUCrashesChange}}</span>
            </mj-text>
          </mj-column>
        </mj-section>
      </mj-column>
      <mj-column width="50%" padding="0 0 0 10px">
        <mj-section css-class="metric-card" padding="15px">
          <mj-column>
            <mj-text font-size="14px" color="#64748b" padding-bottom="5px">
              Dooring Incidents
            </mj-text>
            <mj-text font-size="24px" font-weight="700" padding="0">
              {{dooringCrashes}} <span style="font-size: 14px;">{{dooringCrashesChange}}</span>
            </mj-text>
          </mj-column>
        </mj-section>
      </mj-column>
    </mj-section>

    <!-- Time Series Chart -->
    <mj-section background-color="#ffffff" padding="0 20px 20px 20px">
      <mj-column width="100%">
        <mj-text font-size="20px" font-weight="600" padding="20px 0 10px 0">
          Crashes Over Time
        </mj-text>
        <mj-image src="{{timeSeriesChart}}" width="600px" padding="10px 0" />
      </mj-column>
    </mj-section>

    <!-- Child Injury Time of Day Chart -->
    <mj-section background-color="#ffffff" padding="0 20px 20px 20px">
      <mj-column width="100%">
        <mj-text font-size="20px" font-weight="600" padding="20px 0 10px 0">
          Child Injuries by Time of Day
        </mj-text>
        <mj-image src="{{childTimeOfDayChart}}" width="600px" padding="10px 0" />
        <mj-text font-size="14px" color="#64748b" padding-top="10px">
          This chart shows when children (under 18) are injured in traffic crashes while walking or biking.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- CTA Button -->
    <mj-section background-color="#ffffff" padding="0 20px 20px 20px">
      <mj-column width="100%">
        <mj-text padding="20px 0 10px 0">
          For more detailed analytics and interactive visualizations, visit the dashboard:
        </mj-text>
        <mj-button background-color="#2563EB" color="white" font-size="16px" font-weight="500" border-radius="4px" href="{{dashboardUrl}}" width="250px" padding="10px">
          View Full Dashboard
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#f1f5f9" padding="20px">
      <mj-column>
        <mj-text font-size="14px" color="#64748b" align="center">
          &copy; {{currentYear}} Chicago Traffic Safety Dashboard
        </mj-text>
        <mj-text font-size="14px" color="#64748b" align="center">
          <a href="{{unsubscribeUrl}}" class="footer-link">Unsubscribe</a> | <a href="{{dashboardUrl}}" class="footer-link">Visit Dashboard</a>
        </mj-text>
        <mj-text font-size="12px" color="#94a3b8" align="center" padding-top="10px">
          This email was sent to you because you subscribed to {{reportType}} traffic safety reports for {{geoType}}.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>`
